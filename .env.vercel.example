APP_ENV=production
APP_DEBUG=false

CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Supabase transaction pooler/PgBouncer needs PDO emulated prepares.
PGSQL_ATTR_EMULATE_PREPARES=true

# Laravel Excel/PhpSpreadsheet must use Vercel's writable temp directory.
EXCEL_TEMP_PATH=/tmp/laravel-excel

# Hidden internal PostGIS comparison demo
POSTGIS_DEMO_KEY=change_this_secret_key
